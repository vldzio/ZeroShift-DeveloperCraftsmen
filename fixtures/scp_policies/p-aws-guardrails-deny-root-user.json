{
  "policyId": "p-aws-guardrails-deny-root-user",
  "name": "aws-guardrails-DenyRootUser",
  "controlTowerManaged": true,
  "awsManaged": false,
  "document": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "GRDENYROOTUSERACTIONS",
        "Effect": "Deny",
        "Action": "*",
        "Resource": "*",
        "Condition": {
          "StringLike": {
            "aws:PrincipalArn": [
              "arn:aws:iam::*:root"
            ]
          }
        }
      }
    ]
  }
}
