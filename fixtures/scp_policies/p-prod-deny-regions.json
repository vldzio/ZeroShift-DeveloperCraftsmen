{
  "policyId": "p-prod-deny-regions",
  "name": "DenyNonApprovedRegions",
  "controlTowerManaged": false,
  "awsManaged": false,
  "document": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "DenyAllOutsideApprovedRegions",
        "Effect": "Deny",
        "NotAction": [
          "iam:*",
          "organizations:*",
          "cloudfront:*",
          "route53:*",
          "sts:*",
          "support:*",
          "waf:*"
        ],
        "Resource": "*",
        "Condition": {
          "StringNotEquals": {
            "aws:RequestedRegion": [
              "us-east-1",
              "us-west-2",
              "eu-west-1"
            ]
          }
        }
      }
    ]
  }
}
