{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SandboxS3",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::dev-sandbox-*",
        "arn:aws:s3:::dev-sandbox-*/*"
      ]
    },
    {
      "Sid": "SandboxLambdaInvoke",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "*"
    }
  ]
}
