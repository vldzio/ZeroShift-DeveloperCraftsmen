{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3AppData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "s3:PutBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::zeroshift-demo-app-*",
        "arn:aws:s3:::zeroshift-demo-app-*/*"
      ]
    },
    {
      "Sid": "LoggingWrites",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
